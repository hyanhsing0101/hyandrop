APP_ENV=development
APP_NAME=HyanDrop

POSTGRES_DB=hyandrop
POSTGRES_USER=hyandrop
POSTGRES_PASSWORD=hyandrop_dev_password
DATABASE_URL=postgres://hyandrop:hyandrop_dev_password@postgres:5432/hyandrop?sslmode=disable

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

HTTP_ADDR=:8080
BACKEND_PORT=18080
FRONTEND_PORT=5173
PUBLIC_BASE_URL=http://localhost:5173

ROOM_TTL_HOURS=24
MAX_FILE_SIZE_MB=100
UPLOAD_ROOT=/data/uploads
